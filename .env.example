# Telegram
BOT_TOKEN=cole-o-token-do-botfather
CHANNEL_ID=-1001234567890
ADMIN_TELEGRAM_IDS=111111111,222222222

# Banco (no docker-compose, o host é "postgres")
DATABASE_URL=postgresql+asyncpg://deals:troque-por-uma-senha-longa@localhost:5432/deals

# IA — NVIDIA NIM (API compatível com OpenAI: https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-...
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_TEMPERATURE=0.2

# Shopee Afiliados (GraphQL)
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_GRAPHQL_URL=https://open-api.affiliate.shopee.com.br/graphql

# OPCIONAL — userbot p/ testes E2E (scripts/e2e_admin.py). Não usado pelo app.
# Criar app em https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_FILE=userbot.session

# Comportamento
COLLECT_INTERVAL_MIN=20
MAX_POSTS_PER_DAY=20
MIN_POST_INTERVAL_MIN=10
QUIET_HOURS=00:00-07:00
TIMEZONE=America/Sao_Paulo
MIN_HISTORY_DAYS=7
MIN_DROP_PCT=0.15
MIN_SELLER_RATING=4.5
MIN_SALES_COUNT=5
MIN_OFFICIAL_CONFIDENCE=0.7
LOG_LEVEL=INFO
