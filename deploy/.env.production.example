# Template do .env de PRODUÇÃO na VPS. Preencher com os valores reais no servidor.
# Permissões: chmod 600 .env

# Telegram
BOT_TOKEN=
CHANNEL_ID=
ADMIN_TELEGRAM_IDS=

# Banco (dentro do compose; NUNCA expor a porta do postgres no host)
POSTGRES_USER=deals
POSTGRES_PASSWORD=          # gere uma senha longa e única: openssl rand -base64 32
POSTGRES_DB=deals
DATABASE_URL=postgresql+asyncpg://deals:COLOCAR_A_MESMA_SENHA@postgres:5432/deals

# IA — NVIDIA NIM
NVIDIA_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_TEMPERATURE=0.2

# Shopee Afiliados
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_GRAPHQL_URL=https://open-api.affiliate.shopee.com.br/graphql

# Comportamento
COLLECT_INTERVAL_MIN=20
MAX_POSTS_PER_DAY=20
MIN_POST_INTERVAL_MIN=10
QUIET_HOURS=00:00-07:00
TIMEZONE=America/Sao_Paulo
MIN_HISTORY_DAYS=7
MIN_DROP_PCT=0.15
MIN_SELLER_RATING=4.5
MIN_SALES_COUNT=5
MIN_OFFICIAL_CONFIDENCE=0.7
MAX_RADAR_POSTS_PER_DAY=2
LOG_LEVEL=INFO

# Monitoramento externo (opcional): healthchecks.io — o worker dá ping a cada ciclo;
# se ficar mudo, o healthchecks alerta por e-mail.
HEALTHCHECK_PING_URL=

# Fase 3 (Stripe) — só quando for a hora
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# WEBHOOK_BASE_URL=
